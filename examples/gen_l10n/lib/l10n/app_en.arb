{
  "@@locale": "en",
  "title": "Localisync translations",
  "greeting": "Hello {name}",
  "@greeting": {
    "placeholders": {
      "name": {
        "type": "String"
      }
    }
  },
  "basket": "{count, plural, one {One item} other {# items}}",
  "@basket": {
    "placeholders": {
      "count": {
        "type": "num"
      }
    }
  },
  "date": "Date: {date}",
  "@date": {
    "placeholders": {
      "date": {
        "type": "DateTime",
        "format": "yMd"
      }
    }
  }
}
